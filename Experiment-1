#medain calculation
def median_calculation  (data):
    data.sort()
    if len(data) % 2 == 1:
        return data[len(data) // 2]
    else:
        return (data[len(data) // 2] + data[len(data) // 2 - 1]) / 2

median_calculation([1,2,3,4,5,7])

#mode calculation
def mode_calculation(data):
  counts = {}
  for num in data:
    counts[num] = counts.get(num, 0) + 1

  if not counts:
    return []

  max_count = max(counts.values())
  modes = [key for key, value in counts.items() if value == max_count]
  return modes

mode_calculation([1, 2, 2, 3, 4, 4, 4, 5])

#variance
def variance(data):
  mean= sum(data)/len(data)
  t = 0
  for x in data:
    t+=(x-mean)**2
  return t/len(data)

variance([1,2,3,4,5])

#standard deviation
import math

def standard_deviance(data):
  mean= sum(data)/len(data)
  t = 0
  for x in data:
    t+=(x-mean)**2
  variance = t/len(data)
  return math.sqrt(variance)

standard_deviance([1,2,3,4,5])

