import numpy as np

class Normalization:


  def __init__(self,data,array):
    self.array=array
    self.data=data


  def min_max(self,range):
    normalized_data=(((self.data-np.min(self.array))/(np.max(self.array)-np.min(self.array)))*(range[1]-range[0]))+range[0]
    return normalized_data


  def z_score(self):
    normalized_data=(self.data-np.mean(self.array))/np.std(self.array)
    return normalized_data


  def single_decimal_scaling(self):
    return (self.data/10**(np.floor(np.log10(self.data))+1))


  def multi_decimal_scaling(self,datas):
    for data in datas:
      print(data/10**(np.floor(np.log10(np.max(datas)))+1))

