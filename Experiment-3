import matplotlib.pyplot as plt

# Create figure with 2 rows and 2 columns
fig, axes = plt.subplots(2, 2, figsize=(10, 8))

# -------------------------
# 1. Line Chart
# -------------------------
months = ["Jan", "Feb", "Mar", "Apr", "May"]
sales = [100, 150, 130, 180, 200]

axes[0, 0].plot(months, sales, marker="o")
axes[0, 0].set_title("Monthly Sales")
axes[0, 0].set_xlabel("Month")
axes[0, 0].set_ylabel("Sales")


# -------------------------
# 2. Bar Chart
# -------------------------
subjects = ["Math", "Science", "English", "Computer"]
marks = [85, 78, 92, 95]

axes[0, 1].bar(subjects, marks)
axes[0, 1].set_title("Student Marks")
axes[0, 1].set_xlabel("Subjects")
axes[0, 1].set_ylabel("Marks")


# -------------------------
# 3. Histogram
# -------------------------
data = [45, 50, 55, 60, 62, 65, 68, 70,
        72, 75, 78, 80, 82, 85, 88, 90]

axes[1, 0].hist(data, bins=5, edgecolor="black")
axes[1, 0].set_title("Marks Distribution")
axes[1, 0].set_xlabel("Marks")
axes[1, 0].set_ylabel("Frequency")


# -------------------------
# 4. Scatter Plot
# -------------------------
hours = [1, 2, 3, 4, 5, 6, 7, 8]
scores = [40, 45, 50, 55, 65, 70, 80, 90]

axes[1, 1].scatter(hours, scores)
axes[1, 1].set_title("Study Hours vs Marks")
axes[1, 1].set_xlabel("Hours")
axes[1, 1].set_ylabel("Marks")


# Adjust spacing
plt.tight_layout()

# Display
plt.show()

fig, axes = plt.subplots(2, 2)
